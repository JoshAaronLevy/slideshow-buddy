{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.slideshowbuddy.app",
  "asar": false,
  "productName": "Slideshow Buddy",
  "copyright": "Copyright © 2024 Slideshow Buddy",
  "directories": {
    "buildResources": "resources"
  },
  "files": [
    "index.js",
    "package.json",
    "node_modules/**/*",
    "assets/**/*",
    "build/**/*",
    "capacitor.config.*"
  ],
  "extraResources": [
    {
      "from": "assets/libPhotosLibraryBridge.dylib",
      "to": "assets/libPhotosLibraryBridge.dylib"
    }
  ],
  "publish": {
    "provider": "github"
  },
  "nsis": {
    "allowElevation": true,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "win": {
    "target": "nsis",
    "icon": "assets/appIcon.ico"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "category": "public.app-category.photography",
    "icon": "resources/appIcon.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "resources/entitlements.mac.plist",
    "entitlementsInherit": "resources/entitlements.mac.plist",
    "identity": null,
    "type": "distribution",
    "minimumSystemVersion": "11.0",
    "extendInfo": {
      "CFBundleURLTypes": [
        {
          "CFBundleURLSchemes": [
            "com.slideshowbuddy"
          ],
          "CFBundleURLName": "Slideshow Buddy OAuth Callback"
        }
      ],
      "NSPhotoLibraryUsageDescription": "Access your photo library to create beautiful slideshows"
    }
  },
  "dmg": {
    "background": "assets/dmg-background.png",
    "icon": "resources/appIcon.icns",
    "iconSize": 100,
    "contents": [
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      },
      {
        "x": 130,
        "y": 220,
        "type": "file"
      }
    ],
    "window": {
      "width": 540,
      "height": 380
    },
    "title": "Install Slideshow Buddy"
  }
}