{
  "name": "slideshow-buddy",
  "version": "1.0.0",
  "description": "An Amazing Capacitor App",
  "author": {
    "name": ""
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "build:swift": "./scripts/build-swift.sh",
    "build:ts": "tsc && electron-rebuild",
    "build:clean": "rm -rf app dist",
    "build:validate-env": "./scripts/validate-build-env.sh",
    "build:verify-swift": "./scripts/verify-swift-build.sh",
    "build:verify-ts": "./scripts/verify-ts-build.sh",
    "build:verify-artifacts": "./scripts/verify-build-artifacts.sh",
    "build:orchestrate": "./scripts/build-orchestrator.sh",
    "build": "npm run build:orchestrate",
    "build:reset": "npm run build:clean && npm run build",
    "electron:start:clean": "npm run build:clean && npm run build && npm run electron:start",
    "electron:start:reset": "npm run build:reset && npm run electron:start",
    "electron:start-live": "node ./live-runner.js",
    "electron:start": "npm run build && electron --inspect=5858 ./",
    "electron:pack": "npm run build && electron-builder build --dir -c ./electron-builder.config.json",
    "electron:make": "npm run build && electron-builder build -c ./electron-builder.config.json -p always",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:mac:unsigned": "npm run build && electron-builder --mac --publish never --config.mac.identity=null",
    "build:mac:clean": "npm run build:clean && npm run build && electron-builder --mac --publish never",
    "build:mac:clean-unsigned": "npm run build:clean && npm run build && electron-builder --mac --publish never --config.mac.identity=null",
    "build:mac:reset": "npm run build:reset && electron-builder --mac --publish never",
    "build:mac:reset-unsigned": "npm run build:reset && electron-builder --mac --publish never --config.mac.identity=null",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "notarize": "node scripts/notarize.js",
    "tcc:reset-photos": "tccutil reset Photos com.slideshowbuddy.app || true"
  },
  "dependencies": {
    "@capacitor-community/electron": "^5.0.0",
    "chokidar": "~3.5.3",
    "electron-is-dev": "~2.0.0",
    "electron-serve": "~1.1.0",
    "electron-store": "^11.0.2",
    "electron-unhandled": "~4.0.1",
    "electron-updater": "^5.3.0",
    "electron-window-state": "^5.0.3",
    "keytar": "^7.9.0",
    "koffi": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "electron": "^26.2.2",
    "electron-builder": "~23.6.0",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.0.4"
  },
  "keywords": [
    "capacitor",
    "electron"
  ]
}
